VITE_FIREBASE_APP_ID = "1:362356126985:web:0481a1dd4540577ee44fd8"
VITE_FIREBASE_MEASUREMENT_ID = "G-2S1M8EZ81X"
VITE_FIREBASE_API_KEY = "AIzaSyBUixvCEGp5BjzWVMUBwRpYxBK5jBlHfms"
FIREBASE_PROJECT_ID = "project-ats-aff49"

[nix]
channel = "stable-25_05"
