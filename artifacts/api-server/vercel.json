{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm run typecheck:libs && pnpm --filter @workspace/api-server run build",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "builds": [
    {
      "src": "dist/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/pino-worker.mjs", "dist/thread-stream-worker.mjs"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.mjs"
    }
  ]
}
