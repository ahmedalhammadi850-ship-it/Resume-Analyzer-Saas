{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/resume-analyzer run build",
  "outputDirectory": "artifacts/resume-analyzer/dist",
  "rewrites": [
    { "source": "/api/healthz",       "destination": "/api/settings" },
    { "source": "/api/health",        "destination": "/api/settings" },
    { "source": "/api/pricing-config","destination": "/api/settings" },
    { "source": "/((?!api/).*)",      "destination": "/index.html"   }
  ]
}
