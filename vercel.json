{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "artifacts/resume-analyzer/dist/public"
      }
    },
    {
      "src": "api/healthz.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/n8n-proxy.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/healthz", "dest": "/api/healthz.ts" },
    { "src": "/api/n8n-proxy", "dest": "/api/n8n-proxy.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
